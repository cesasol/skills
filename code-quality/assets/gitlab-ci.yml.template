# Quality-first GitLab CI pipeline.
# The quality stage is blocking: no allow_failure, no manual gates.
# Delete the jobs whose stacks this repository does not use.

stages:
  - quality
  - test

default:
  image: ghcr.io/astral-sh/uv:python3.14-bookworm-slim
  interruptible: true

variables:
  UV_CACHE_DIR: "$CI_PROJECT_DIR/.uv-cache"
  UV_LINK_MODE: copy

# Run on merge requests, tags, and branches; skip the branch pipeline while an MR is open.
workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_TAG
    - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS
      when: never
    - if: $CI_COMMIT_BRANCH

include:
  - template: Security/SAST.gitlab-ci.yml
  - template: Security/Secret-Detection.gitlab-ci.yml

.uv-cache:
  cache:
    key:
      files: [uv.lock]
    paths: [.venv, .uv-cache]
    policy: pull

.uv-setup:
  extends: .uv-cache
  before_script:
    - uv sync --frozen --all-packages --all-groups

# `just` is not in the image, and `uvx rust-just` does not work: the package's
# binary is named `just`, so uv needs --from. Verify any change to this line.
.just:
  extends: .uv-setup
  variables:
    JUST: uvx --from rust-just just

# ── quality ──────────────────────────────────────────────────────────────────

# One job runs every hook — formatters, linters, gitleaks, hygiene — across the
# whole tree. SKIP=no-commit-to-branch: that hook fails by design on main.
quality:hooks:
  stage: quality
  variables:
    SKIP: no-commit-to-branch
  script:
    - uvx prek run --all-files

# Every job below calls a recipe. Nothing restates the recipe's commands: that
# divergence between CI and the developer is what the baseline exists to stop.
quality:checks:
  extends: .just
  stage: quality
  script:
    - $JUST fmt-check
    - $JUST lint
    - $JUST typecheck

# The security templates default to a `test` stage; repin them here.
sast:
  stage: quality

secret_detection:
  stage: quality

# ── test ─────────────────────────────────────────────────────────────────────

# `just test` writes coverage.xml and report.xml; the job only collects them.
test:
  extends: .just
  stage: test
  coverage: '/^TOTAL\s+.*\s+(\d+(?:\.\d+)?)%$/'
  script:
    - $JUST test
  artifacts:
    when: always
    expire_in: 1 week
    reports:
      junit: report.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

# ── polyglot repositories ────────────────────────────────────────────────────
#
# When `just ci` spans two toolchains, one job needs both of them. Pick one:
#
#   1. One job, one image carrying both. Preferred when the repository really is
#      one deployable. Build that image yourself and pin it; installing Node into
#      the uv image at job time is slow and unpinned.
#
#        quality:all:
#          image: registry.example.com/ci/uv-node:3.14-22
#          extends: .just
#          stage: quality
#          script: [$JUST ci]
#
#   2. One job per stack, each calling the recipe it can run. `just ci` stays the
#      complete local gate; the pipeline splits it for images and parallelism.
#
#        quality:web:
#          image: node:22-bookworm-slim
#          stage: quality
#          before_script:
#            - corepack enable
#            - pnpm install --frozen-lockfile
#          script:
#            - pnpm exec oxlint --max-warnings 0
#
# Option 2 restates commands in YAML, which rule 2 forbids. Give the package its
# own justfile and call `just --justfile web/justfile lint` instead, so the
# command still lives in a recipe.
