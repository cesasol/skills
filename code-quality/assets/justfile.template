# Project commands. `just ci` is the single entry point for CI, hooks, and agents.
# Keep every recipe non-interactive and safe to repeat, except `dev` and `start`.
#
# The recipe names below are the contract. Keep the names, replace the bodies
# with this repository's real commands, and delete any recipe the repository has
# no work for. See references/just-recipes.md for the bodies per repository type.

set shell := ["bash", "-euo", "pipefail", "-c"]

# List available recipes.
default:
    @just --list

# ── verification ─────────────────────────────────────────────────────────────
#
# `ci` composes the gates and implements nothing. Add `build` to it when the
# artifact is what the repository ships. Only the last comment line above a
# recipe reaches `just --list`, so keep each one to a single line.

# Everything a merge must satisfy. CI calls exactly this.
ci: fmt-check lint typecheck test

# Linters, read-only. Warnings are errors. This recipe never rewrites a file.
lint:
    uv run ruff check .
    pnpm exec oxlint --max-warnings 0

# Every safe automatic repair. `&& fmt` formats after the body, never before.
fix: && fmt
    uv run ruff check --fix .
    pnpm exec oxlint --fix

# Formatters, autofixing. Run before committing.
fmt:
    uv run ruff format .
    pnpm exec prettier --write .

# Formatting verification. Never rewrites files.
fmt-check:
    uv run ruff format --check .
    pnpm exec prettier --check .

# Type checkers. Vue or Nuxt needs vue-tsc, Svelte needs svelte-check, and
# either one must be a devDependency before `pnpm exec` can find it.
typecheck:
    uv run ty check
    pnpm exec tsc --noEmit

# Test suites, with coverage.
test:
    uv run --no-sync pytest --cov --cov-report=term
    pnpm exec vitest run --coverage

# ── artifacts and running ────────────────────────────────────────────────────
#
# Keep these three only when the repository has the thing they act on. A build
# writes to an ignored path; `dev` and `start` are the only recipes allowed to
# block, and nothing else may depend on them.

# Produce the deployable artifact. Output goes to an ignored path.
build:
    uv build
    pnpm run build

# Local loop: reload on save, debug settings, localhost.
dev:
    uv run --no-sync fastapi dev src/app/main.py

# The production command, unmodified. The container entrypoint runs it too.
start:
    uv run --no-sync uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}

# ── environment ──────────────────────────────────────────────────────────────

# Install locked dependencies and the git hooks. The only installing recipe.
setup:
    uv sync --frozen --all-packages --all-groups
    pnpm install --frozen-lockfile
    uvx prek install

# Run every hook across the whole tree, as CI does.
hooks:
    uvx prek run --all-files

# Refresh hook revisions, then verify the suite still passes.
hooks-update:
    uvx prek auto-update
    uvx prek run --all-files

# Report the quality-baseline gaps of this repository.
audit:
    bash scripts/audit.sh .

# Format this justfile, when the installed just supports it.
fmt-just:
    just --fmt
